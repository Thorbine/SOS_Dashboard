#!/bin/bash
# Startet den Instagram Downloader ohne Terminalfenster. Die Programmdateien liegen drei Ordner hoeher.
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$DIR" || exit 1
export PATH="/Library/Frameworks/Python.framework/Versions/Current/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"
PY="$(command -v python3)"
fehler() { osascript -e "display dialog \"$1\" buttons {\"OK\"} default button 1 with icon stop with title \"Instagram Downloader\"" >/dev/null; exit 1; }
[ -z "$PY" ] && fehler "Python wurde nicht gefunden. Bitte Python 3.11 oder neuer von python.org installieren."
if ! "$PY" -c "import yt_dlp, certifi, tkinter" 2>/dev/null; then
  "$PY" -m pip install -q --prefer-binary yt-dlp certifi 2>/tmp/instagram_downloader_pip.log \
    || fehler "Installation fehlgeschlagen (Internetverbindung, oder Python ohne tkinter?). Details: /tmp/instagram_downloader_pip.log"
fi
ERR="$(mktemp)"
SSL_CERT_FILE="$("$PY" -c 'import certifi;print(certifi.where())')" "$PY" app.py 2>"$ERR"
if [ $? -ne 0 ]; then
  cp "$ERR" "$HOME/instagram-downloader-startfehler.txt"; rm -f "$ERR"
  fehler "Das Programm ist abgestürzt. Details: instagram-downloader-startfehler.txt im Benutzerordner."
fi
rm -f "$ERR"
